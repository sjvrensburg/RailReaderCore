<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OcrCostProbe</AssemblyName>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Direct reference so RapidOcrNet's own build target copies the bundled PP-OCRv5 models
         beside the binary. The target lives in the package's build/ folder and only runs for a
         project that references the package directly — a transitive ProjectReference does not
         trigger it, and the probe then reports the bundled tier as "not installed". -->
    <PackageReference Include="RapidOcrNet" Version="4.0.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/RailReader.Core/RailReader.Core.csproj" />
    <ProjectReference Include="../../src/RailReader.Core.Pdfium/RailReader.Core.Pdfium.csproj" />
    <ProjectReference Include="../../src/RailReader.Core.Ocr.RapidOcr/RailReader.Core.Ocr.RapidOcr.csproj" />
    <ProjectReference Include="../../src/RailReader.Renderer.Skia/RailReader.Renderer.Skia.csproj" />
  </ItemGroup>
</Project>
