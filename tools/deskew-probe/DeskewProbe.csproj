<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeskewProbe</AssemblyName>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Direct reference so RapidOcrNet's own build target copies the PP-OCR models beside the
         binary. The target lives in the package's build/ folder and only runs for a project
         that references the package directly — a transitive ProjectReference does not trigger
         it, and the probe then throws FileNotFoundException on startup. -->
    <PackageReference Include="RapidOcrNet" Version="3.0.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/RailReader.Core/RailReader.Core.csproj" />
    <ProjectReference Include="../../src/RailReader.Core.Pdfium/RailReader.Core.Pdfium.csproj" />
    <ProjectReference Include="../../src/RailReader.Core.Ocr.RapidOcr/RailReader.Core.Ocr.RapidOcr.csproj" />
    <ProjectReference Include="../../src/RailReader.Renderer.Skia/RailReader.Renderer.Skia.csproj" />
  </ItemGroup>
</Project>
