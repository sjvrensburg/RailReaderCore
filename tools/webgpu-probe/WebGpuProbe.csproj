<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WebGpuProbe</AssemblyName>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/RailReader.Core/RailReader.Core.csproj" />
    <ProjectReference Include="../../src/RailReader.Core.Analysis/RailReader.Core.Analysis.csproj" />
    <ProjectReference Include="../../src/RailReader.Core.Pdfium/RailReader.Core.Pdfium.csproj" />
    <ProjectReference Include="../../src/RailReader.Renderer.Skia/RailReader.Renderer.Skia.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Plugin EP, spike-only: registers a Dawn-backed WebGPU execution provider
         alongside the CPU Microsoft.ML.OnnxRuntime package already referenced
         transitively via Core.Analysis. Requires core ORT >=1.24.4 (satisfied
         by Core.Analysis's "1.24.*" floating pin, which resolves to 1.24.4+). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.EP.WebGpu" Version="0.3.0" />
  </ItemGroup>
</Project>
