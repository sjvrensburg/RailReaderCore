<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <NoWarn>CA1416</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>RailReader.Core</PackageId>
    <Description>Portable abstractions, models, controllers, rail-navigation, line detection, search, and annotation logic for RailReader.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RailReader.Core.Tests" />
    <InternalsVisibleTo Include="RailReader.Core.Pdfium" />
    <InternalsVisibleTo Include="RailReader.Core.Analysis" />
    <InternalsVisibleTo Include="RailReader.Core.Vlm.OpenAI" />
    <InternalsVisibleTo Include="RailReader.Renderer.Skia" />
    <!-- Diagnostic tool: needs OcrPageMapper and LineDetector's per-strategy entry points to
         report what each stage of line grouping did, which the public surface deliberately
         hides behind DetectLines. -->
    <InternalsVisibleTo Include="DeskewProbe" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
