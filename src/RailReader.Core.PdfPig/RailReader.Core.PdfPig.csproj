<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>RailReader.Core.PdfPig</PackageId>
    <Description>Pure-managed implementations of Core's PDF text/link/outline services using UglyToad.PdfPig. Targets web/mobile/Lite consumers that cannot ship PDFium. Parses only; rasterisation lives in a sibling renderer.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RailReader.Core.Tests" />
    <InternalsVisibleTo Include="RailReader.Renderer.PdfPigSkia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RailReader.Core/RailReader.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned to one minor, in lockstep with PdfPig.Rendering.Skia in RailReader.Renderer.PdfPigSkia:
         with a floating 0.1.* the renderer threw TypeLoadException
         (PatternAwareColorSpaceContext.SetStrokingColor) on the first render, most likely because PdfPig
         resolved ahead of the version the renderer was built against. Bump both together. -->
    <PackageReference Include="PdfPig" Version="[0.1.16,0.1.17)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
